{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecterSystemConfig",
  "description": "Configuration schema for Workstation Identity & Cloud Pairing (~/.tuquet/system/system.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference URL"
    },
    "machine_name": {
      "type": "string",
      "description": "Canonical workstation identifier displayed in Cloud"
    },
    "cloud_url": {
      "type": "string",
      "default": "https://cloud.tuquet.dev",
      "description": "Target Cloud API URL endpoint"
    },
    "auto_check_update": {
      "type": "boolean",
      "default": true,
      "description": "Perform automatic non-blocking daily update checks"
    },
    "update_channel": {
      "type": "string",
      "default": "stable",
      "enum": ["stable", "beta", "nightly"],
      "description": "release update channel"
    },
    "environment": {
      "type": "string",
      "default": "production",
      "description": "Execution environment profile"
    }
  }
}
