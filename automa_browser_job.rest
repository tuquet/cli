# ------------------------------------------------------------------------------
# 4. MONITORING: LOGS & CONTEXT TUNG NODE, TRANG THAI JOB
# ------------------------------------------------------------------------------

### 4.1 Xem chi tiet Logs & Context tung node cua Job
@targetJobId = {{runWithWorkflowId.response.body.jobId}}
GET {{baseUrl}}/api/v1/history/{{targetJobId}}/logs

### 4.2 Kiem tra trang thai Job (running / completed / failed)
GET {{baseUrl}}/api/v1/jobs/{{targetJobId}}/status

### 4.3 Danh sach 5 lich su chay gan nhat
GET {{baseUrl}}/api/v1/history?limit=5

### 4.4 Stream Real-Time Logs qua SSE
GET {{baseUrl}}/api/v1/events
Accept: text/event-stream

### 4.5 Dung khan cap Job dang chay
DELETE {{baseUrl}}/api/v1/jobs/{{targetJobId}}


# ------------------------------------------------------------------------------
# 5. BROWSER SESSION CONTROL
# ------------------------------------------------------------------------------

### 5.1 Mo trinh duyet truc tiep (Manual session)
POST {{baseUrl}}/api/v1/browsers/default/session
Content-Type: {{contentType}}

{
  "headless": false
}

### 5.2 Dong phien trinh duyet manual
DELETE {{baseUrl}}/api/v1/browsers/default/session

### 5.3 Don sach tat ca tien trinh Chromium dang chay
DELETE {{baseUrl}}/api/v1/browsers/sessions
