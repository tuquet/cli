###############################################################################
# 5. JOB LIFECYCLE, STATUS TRACKING & LOGS
###############################################################################

### 5.1 Check Status of the Last Submitted Visual Job
@visualJobId = {{submitVisualJob.response.body.jobId}}
GET {{baseUrl}}/api/v1/jobs/{{visualJobId}}/status

### 5.2 Stream Real-Time Execution Logs (Server-Sent Events)
GET {{baseUrl}}/api/v1/events
Accept: text/event-stream

### 5.3 Query Execution History
GET {{baseUrl}}/api/v1/history?limit=10

### 5.4 Kill a Running Job (Dừng khẩn cấp tiến trình)
DELETE {{baseUrl}}/api/v1/jobs/{{visualJobId}}

###############################################################################
# 6. DIRECT ANTI-DETECT BROWSER PROFILE SESSION (Mở phiên trình duyệt trực tiếp)
###############################################################################

### 6.1 Launch Direct Browser Session (Default Profile)
POST {{baseUrl}}/api/v1/browsers/default/session
Content-Type: {{contentType}}

{
  "headless": false
}

### 6.2 Stop Direct Browser Session
DELETE {{baseUrl}}/api/v1/browsers/default/session

### 6.3 Kill All Running Browser Sessions (Dọn sạch toàn bộ trình duyệt)
DELETE {{baseUrl}}/api/v1/browsers/sessions
