### Specter Automa Runner - Storage Variables, Credentials, Tables & Backup
@baseUrl = http://127.0.0.1:8765
@contentType = application/json

# ====================================================================
# 5.1 GLOBAL STORAGE VARIABLES
# ====================================================================

### 5.1.1 Danh sach cac bien toan cuc (Variables)
GET {{baseUrl}}/api/v1/storage/variables

### 5.1.2 Luu hoac cap nhat bien toan cuc
# @name saveVariable
POST {{baseUrl}}/api/v1/storage/variables
Content-Type: {{contentType}}

{
  "name": "API_ENDPOINT",
  "key": "apiEndpoint",
  "value": "https://api.specter.dev/v1"
}

### 5.1.3 Xoa bien toan cuc theo Key hoac ID
@varKey = {{saveVariable.response.body.key}}
DELETE {{baseUrl}}/api/v1/storage/variables/{{varKey}}

# ====================================================================
# 5.2 ENCRYPTED CREDENTIALS & SECRETS
# ====================================================================

### 5.2.1 Danh sach cac credentials luu trong SQLite
GET {{baseUrl}}/api/v1/storage/credentials

### 5.2.2 Luu credential bao mat moi
# @name saveCredential
POST {{baseUrl}}/api/v1/storage/credentials
Content-Type: {{contentType}}

{
  "name": "Github Personal Token",
  "key": "github_pat",
  "value": "ghp_mock_token_secret_for_testing"
}

### 5.2.3 Xoa credential theo Key hoac ID
@credKey = {{saveCredential.response.body.key}}
DELETE {{baseUrl}}/api/v1/storage/credentials/{{credKey}}

# ====================================================================
# 5.3 DYNAMIC DATA TABLES & ROWS
# ====================================================================

### 5.3.1 Danh sach cac bang du lieu (Tables)
GET {{baseUrl}}/api/v1/storage/tables

### 5.3.2 Tao table schema moi
# @name createTable
POST {{baseUrl}}/api/v1/storage/tables
Content-Type: {{contentType}}

{
  "name": "Ecommerce Products",
  "columns": [
    { "id": "col_sku", "name": "SKU", "type": "string" },
    { "id": "col_title", "name": "Title", "type": "string" },
    { "id": "col_price", "name": "Price", "type": "number" }
  ]
}

### 5.3.3 Them mot dong du lieu (Row) vao Table
@tableId = {{createTable.response.body.id}}
# @name addRow
POST {{baseUrl}}/api/v1/storage/tables/{{tableId}}/rows
Content-Type: {{contentType}}

{
  "SKU": "PRD-001",
  "Title": "Mechanical Keyboard",
  "Price": 129.99
}

### 5.3.4 Lay danh sach cac dong du lieu trong Table (ho tro phan trang)
GET {{baseUrl}}/api/v1/storage/tables/{{tableId}}/rows?limit=20&offset=0

### 5.3.5 Xoa Table khoi SQLite
DELETE {{baseUrl}}/api/v1/storage/tables/{{tableId}}

# ====================================================================
# 5.4 FULL SYSTEM BACKUP & RESTORE
# ====================================================================

### 5.4.1 Export toan bo du lieu SQLite (Workflows, Variables, Tables)
# @name exportBackup
GET {{baseUrl}}/api/v1/storage/backup/export

### 5.4.2 Export backup co ma hoa bang mat khau (AES-256-CBC + HMAC)
GET {{baseUrl}}/api/v1/storage/backup/export?password=TuquetMasterKey2026

### 5.4.3 Restore backup JSON vao SQLite
POST {{baseUrl}}/api/v1/storage/backup/restore
Content-Type: {{contentType}}

{
  "backup": {
    "workflows": [],
    "storageVariables": [
      { "name": "ENV", "key": "env", "value": "production" }
    ],
    "storageTables": []
  }
}

