### Tuquet Automa Runner - Job Execution & Real-Time Monitoring
@baseUrl = http://127.0.0.1:8765
@contentType = application/json

### 3.1 Tao Job Visual GUI (Google Search bang JS)
# @name submitVisualJob
POST {{baseUrl}}/api/v1/jobs
Content-Type: {{contentType}}

{
  "workflowData": {
    "name": "Direct Google Search Automation",
    "description": "Trigger -> Mo Google -> JS Search -> Delay",
    "drawflow": {
      "nodes": [
        {
          "id": "node-trigger",
          "label": "trigger",
          "data": {
            "description": "Khoi dong job va nap bien",
            "type": "manual",
            "parameters": [
              {
                "name": "searchQuery",
                "value": "tuquet automa direct inline run"
              }
            ]
          }
        },
        {
          "id": "node-new-tab",
          "label": "new-tab",
          "data": {
            "description": "Dieu huong den google.com",
            "url": "https://www.google.com",
            "active": true,
            "updatePrevTab": true,
            "waitTabLoaded": true
          }
        },
        {
          "id": "node-js-search",
          "label": "javascript-code",
          "data": {
            "description": "Dien tu khoa va submit form tim kiem",
            "code": "const query = (typeof automaRefData === 'function' ? automaRefData('variables', 'searchQuery') : null) || '{{ variables.searchQuery }}' || 'tuquet automa'; const searchInput = document.querySelector('textarea[name=\"q\"]') || document.querySelector('input[name=\"q\"]'); if (searchInput) { searchInput.focus(); searchInput.value = query; searchInput.dispatchEvent(new Event('input', { bubbles: true })); searchInput.form?.submit(); } else { window.location.href = 'https://www.google.com/search?q=' + encodeURIComponent(query); } if (typeof automaNextBlock === 'function') automaNextBlock({ query, action: 'searched' });",
            "context": "webpage",
            "preloadScripts": [],
            "timeout": 10000
          }
        },
        {
          "id": "node-delay",
          "label": "delay",
          "data": {
            "description": "Cho 6s quan sat ket qua",
            "time": 6000
          }
        }
      ],
      "edges": [
        {
          "id": "edge-1",
          "source": "node-trigger",
          "target": "node-new-tab",
          "sourceHandle": "node-trigger-output-1",
          "targetHandle": "node-new-tab-input-1"
        },
        {
          "id": "edge-2",
          "source": "node-new-tab",
          "target": "node-js-search",
          "sourceHandle": "node-new-tab-output-1",
          "targetHandle": "node-js-search-input-1"
        },
        {
          "id": "edge-3",
          "source": "node-js-search",
          "target": "node-delay",
          "sourceHandle": "node-js-search-output-1",
          "targetHandle": "node-delay-input-1"
        }
      ]
    }
  },
  "options": {
    "headless": false,
    "closeBrowserOnFinish": false,
    "variables": {
      "searchQuery": "tuquet automa pure open source chromium"
    }
  }
}

### 3.2 Tao Job chay ngam khong mo cua so (Headless)
# @name submitHeadlessJob
POST {{baseUrl}}/api/v1/jobs
Content-Type: {{contentType}}

{
  "workflowData": {
    "name": "Headless Background Job",
    "description": "Mo httpbin.org va ket thuc",
    "drawflow": {
      "nodes": [
        {
          "id": "node-trigger",
          "label": "trigger",
          "data": {
            "description": "Trigger chay ngam",
            "type": "manual"
          }
        },
        {
          "id": "node-new-tab",
          "label": "new-tab",
          "data": {
            "description": "Mo trang httpbin.org/get",
            "url": "https://httpbin.org/get",
            "active": true
          }
        },
        {
          "id": "node-delay",
          "label": "delay",
          "data": {
            "description": "Cho 2s roi dong",
            "time": 2000
          }
        }
      ],
      "edges": [
        {
          "id": "edge-1",
          "source": "node-trigger",
          "target": "node-new-tab"
        },
        {
          "id": "edge-2",
          "source": "node-new-tab",
          "target": "node-delay"
        }
      ]
    }
  },
  "options": {
    "headless": true,
    "closeBrowserOnFinish": true
  }
}

### 3.3 Danh sach cac Job dang chay (Active Jobs)
GET {{baseUrl}}/api/v1/jobs

### 3.4 Kiem tra trang thai Job theo ID
@targetJobId = {{submitVisualJob.response.body.jobId}}
GET {{baseUrl}}/api/v1/jobs/{{targetJobId}}/status

### 3.5 Xem chi tiet Logs & Context tung node cua Job
GET {{baseUrl}}/api/v1/history/{{targetJobId}}/logs

### 3.6 Danh sach 5 lich su chay gan nhat
GET {{baseUrl}}/api/v1/history?limit=5

### 3.7 Stream Real-Time Logs qua Server-Sent Events (SSE)
GET {{baseUrl}}/api/v1/events
Accept: text/event-stream

### 3.8 Dung khan cap Job dang chay
DELETE {{baseUrl}}/api/v1/jobs/{{targetJobId}}

### 3.9 Negative Test - Kiem tra Job khong ton tai (Expect 404 Not Found)
GET {{baseUrl}}/api/v1/jobs/non-existent-job-uuid/status
